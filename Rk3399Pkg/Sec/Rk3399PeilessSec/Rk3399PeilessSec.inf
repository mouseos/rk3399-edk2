  BaseMemoryLib
  CacheMaintenanceLib
  DebugAgentLib
  DebugLib
  HobLib
  MemoryInitPeiLib
  PeilessSecMeasureLib
  PerformanceLib
  PlatformPeiLib
  PrePiHobListPointerLib
  PrePiLib
  PrintLib
  SerialPortLib
  TimerLib
  StackCheckLib
  ArmTransferListLib

[Ppis]
